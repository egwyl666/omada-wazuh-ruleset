# OPTIONAL. Runs the download every night; the apply part installs the changed lists right
# after it. Nothing is restarted: the lists take effect at the next restart of wazuh-manager.
[Unit]
Description=Omada/Wazuh: nightly threat-intel download

[Timer]
OnCalendar=*-*-* 04:15
RandomizedDelaySec=10min
# Persistent=false: a run missed while the host was off is simply skipped.
Persistent=false

[Install]
WantedBy=timers.target
